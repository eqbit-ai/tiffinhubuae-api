DATABASE_URL=postgresql://user:password@localhost:5432/tiffinhub
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=price_your_price_id
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+1234567890

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# Scheduled jobs
#
# CRON_SECRET guards POST /api/cron/:schedule, which GitHub Actions calls on a
# timer. Unset means the endpoint refuses every call with 503 — it fails closed,
# never open. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Set to "false" on a host that sleeps (Render free), where GitHub Actions
# triggers the jobs over HTTP instead. Leave unset on an always-on host.
# Never have both running: every job would execute twice.
INTERNAL_CRON=
